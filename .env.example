# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false
# Cash the player starts with (default 0). Restart the dev server after changing.
VITE_START_CASH=0
# Strength the player starts with (default 1). Restart the dev server after changing.
VITE_START_STRENGTH=1
# Rebirth count the player starts with (default 0). Restart the dev server after changing.
VITE_START_REBIRTHS=0

# Colyseus backend (Lift-rock-for-treasure-backend), one URL per Bloxity Legion channel.
# `npm run dev` uses _DEV (default ws://localhost:2567); `npm run build` (production) uses _MAIN.
# `npm run build:dev` is mode "development", so it also uses _DEV. Leave _MAIN empty until prod is deployed.
VITE_SERVER_URL_DEV=ws://localhost:2567
VITE_SERVER_URL_MAIN=
